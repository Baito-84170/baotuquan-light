<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.self.water"
    android:versionCode="46"
    android:versionName="7.8">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 应用内下载并安装自己的新版本（检查更新用），不用于安装其它应用 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 11+ 的包可见性（package visibility）限制：
         不声明 queries 的话，PackageManager 查不到下面这些应用有没有装，
         也就无法判断该走哪个渠道（支付宝小程序 / 官方 App）。
         这里只声明包名，不申请任何权限，也不读取跨应用数据。 -->
    <queries>
        <package android:name="com.qiekj.user" />
        <package android:name="com.xiaolian.prometheus" />
        <package android:name="com.cloudora.android" />
        <package android:name="com.eg.android.AlipayGphone" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WaterActivity"
            android:exported="false"
            android:label="@string/svc_water" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/login_title" />

        <activity
            android:name=".ShowerActivity"
            android:exported="false"
            android:label="@string/shower_title" />

        <activity
            android:name=".PanggualLoginActivity"
            android:exported="false"
            android:label="@string/pg_login_title" />

        <activity
            android:name=".DevicesActivity"
            android:exported="false"
            android:label="@string/devices_title" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="portrait"
            android:label="@string/scan_title" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".OrdersActivity"
            android:exported="false"
            android:label="@string/orders_title" />

        <activity
            android:name=".ShowerDevicePickerActivity"
            android:exported="false"
            android:label="@string/picker_title" />

        <activity
            android:name=".WaterDevicePickerActivity"
            android:exported="false"
            android:label="@string/picker_title" />

        <!-- 桌面小组件。APPWIDGET_UPDATE 是系统广播，必须 exported="true"，
             否则部分 ROM（含 MIUI）不会把更新事件投递过来。 -->
        <receiver
            android:name=".WidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
