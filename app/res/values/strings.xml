    <string name="about_developer">METACOLA</string>
    <string name="about_desc">一个给山东大学趵突泉校区同学做的小工具，把取水、洗澡、洗衣三件事收进一个 App。\n\n基于对官方 App 接口的互操作性分析独立实现，不包含任何原应用的代码或资源。\n\n账号与设备信息只保存在你自己的手机上。</string>
    <string name="about_version_label">版本号</string>
    <string name="about_version_placeholder">—</string>
    <string name="about_contact">使用中遇到问题、想加功能，或者想把自己楼里的设备整理进内置设备库，都可以直接找开发者。\n\n开发者：METACOLA</string>
