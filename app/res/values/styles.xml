<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textColorHighlight">@color/primary_light</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <!-- 关掉系统「强制深色」，否则选「始终浅色」时 Android 10+ 会自己反色 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textColorHighlight">@color/primary_light</item>
        <item name="android:colorControlActivated">@color/primary</item>
    </style>

    <!-- 卡片标题 -->
    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- 输入框上方的字段名 -->
    <style name="FieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <!-- 主按钮 -->
    <style name="BtnPrimary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- 次要按钮（描边） -->
    <style name="BtnOutline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 纯文字按钮 -->
    <style name="BtnGhost">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 输入框 -->
    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
