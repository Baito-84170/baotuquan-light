<?xml version="1.0" encoding="utf-8"?>
<!--
  尺寸说明（这是之前搞错的地方，记下来）：

  Android 的 widget 尺寸公式是  minWidth  = 列数×70 − 30
                              minHeight = 行数×70 − 30
  所以：1 行 = 40dp，2 行 = 110dp。

  之前我填了 84dp —— 夹在 1 行和 2 行之间。桌面按 targetCellHeight=1 分给它 1 行的高度，
  而布局却按 84dp 设计，结果就是内容挤在一起、留白诡异。

  现在按 1 行的标准值 40dp 声明，并开启双向 resize：想要更大自己在桌面拖就行，
  布局用 weight + match_parent，拉高拉宽都不会崩。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_home"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
