<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置。

    默认和以前一样：**禁止明文 HTTP**（base-config）。

    唯一特殊的是自建的更新镜像 —— 它用的是自己签的证书，系统不认，所以这里
    只对它固定（pin）那一张证书。

    注意 trust-anchors 是**替换**而不是追加：这几个 IP 上只认我们自己签的证书，
    别的 CA 签的一律不认。这正是我们要的 —— 别人就算伪造了这个源也装不进来。
    其它域名（GitHub、惠生活798、胖乖生活）走系统默认信任，不受影响。
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="false">
        <!-- 阿里云服务器 -->
        <domain includeSubdomains="false">120.27.236.74</domain>
        <!-- 联调用的局域网地址 -->
        <domain includeSubdomains="false">192.168.31.96</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="@raw/server_cert" />
        </trust-anchors>
    </domain-config>

</network-security-config>
