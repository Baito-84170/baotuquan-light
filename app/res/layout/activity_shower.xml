<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shower_title"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:letterSpacing="-0.01" />

            <Button
                android:id="@+id/btnShowerMore"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                style="@style/BtnGhost"
                android:textSize="18sp"
                android:text="⋮" />
        </LinearLayout>

        <!-- 设备卡片：点整块切换设备 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/showerPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/showerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/shower_not_queried"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/showerMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub" />

                    <TextView
                        android:id="@+id/showerSku"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 实时占用：空闲 / 使用中 / — -->
                <TextView
                    android:id="@+id/showerOccupy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_badge"
                    android:textSize="12sp"
                    android:text="@string/occupy_unknown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▾"
                    android:textSize="17sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/divider" />

            <!-- 支付方式 -->
            <LinearLayout
                android:id="@+id/payRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:text="@string/label_pay_type" />

                <TextView
                    android:id="@+id/payMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:text="@string/pay_type_unknown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/primary"
                    android:text="切换" />
            </LinearLayout>
        </LinearLayout>

        <!-- 同层空闲机器：站门口发现有人时，直接在这里换一台 -->
        <LinearLayout
            android:id="@+id/floorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/floorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ok" />

            <LinearLayout
                android:id="@+id/floorChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="start" />
        </LinearLayout>

        <!-- 未结束的订单 -->
        <LinearLayout
            android:id="@+id/pendingBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/pendingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shower_pending_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/warn" />

            <TextView
                android:id="@+id/pendingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_sub" />

            <Button
                android:id="@+id/btnPendingEnd"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                style="@style/BtnPrimary"
                android:text="@string/btn_pending_end" />

            <Button
                android:id="@+id/btnPendingCancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                style="@style/BtnGhost"
                android:text="@string/btn_pending_cancel" />
        </LinearLayout>

        <!-- 登录提示 -->
        <LinearLayout
            android:id="@+id/loginBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shower_need_login"
                android:textSize="14sp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnPgLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                style="@style/BtnPrimary"
                android:text="@string/btn_pg_login" />
        </LinearLayout>

        <!-- 主操作 -->
        <Button
            android:id="@+id/btnShowerStart"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="18dp"
            style="@style/BtnPrimary"
            android:textSize="22sp"
            android:enabled="false"
            android:text="@string/btn_shower_start" />

        <Button
            android:id="@+id/btnShowerEnd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            style="@style/BtnOutline"
            android:text="@string/btn_shower_end" />

        <TextView
            android:id="@+id/showerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textSize="13sp"
            android:textColor="@color/idle"
            android:text="@string/shower_status_idle" />
    </LinearLayout>
</ScrollView>
